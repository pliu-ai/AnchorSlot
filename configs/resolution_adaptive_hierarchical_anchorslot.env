# Resolution-Adaptive Hierarchical Parallel AnchorSlot (RA-HPA).
export NNUNET_HPA_CODE_DIM="${NNUNET_HPA_CODE_DIM:-64}"
export NNUNET_HPA_LAMBDA_SEMANTIC_CE="${NNUNET_HPA_LAMBDA_SEMANTIC_CE:-1.0}"
export NNUNET_HPA_LAMBDA_SEMANTIC_DICE="${NNUNET_HPA_LAMBDA_SEMANTIC_DICE:-1.0}"
export NNUNET_HPA_LAMBDA_COARSE_CE="${NNUNET_HPA_LAMBDA_COARSE_CE:-0.5}"
export NNUNET_HPA_LAMBDA_SLOT_CE="${NNUNET_HPA_LAMBDA_SLOT_CE:-0.5}"

export NNUNET_RAHPA_REFERENCE_VOXEL_SIZE="${NNUNET_RAHPA_REFERENCE_VOXEL_SIZE:-4,4,4}"
export NNUNET_RAHPA_LAMBDA_PARENT="${NNUNET_RAHPA_LAMBDA_PARENT:-0.5}"
export NNUNET_RAHPA_LAMBDA_HIERARCHY="${NNUNET_RAHPA_LAMBDA_HIERARCHY:-0.25}"
export NNUNET_RAHPA_LAMBDA_BOUNDARY="${NNUNET_RAHPA_LAMBDA_BOUNDARY:-0.1}"
export NNUNET_RAHPA_LAMBDA_AFFINITY="${NNUNET_RAHPA_LAMBDA_AFFINITY:-0.1}"
export NNUNET_RAHPA_IGNORE_UNANNOTATED_BACKGROUND="${NNUNET_RAHPA_IGNORE_UNANNOTATED_BACKGROUND:-0}"

# A single shared model alternates clean 4-nm and native 32-nm batches.
export NNUNET_RAHPA_AUX_DATASET_ID="${NNUNET_RAHPA_AUX_DATASET_ID:-201}"
export NNUNET_RAHPA_AUX_CONFIGURATION="${NNUNET_RAHPA_AUX_CONFIGURATION:-3d_fullres}"
export NNUNET_RAHPA_AUX_PROBABILITY="${NNUNET_RAHPA_AUX_PROBABILITY:-0.5}"

export NNUNET_STRUCTCOND_INITIAL_LR="${NNUNET_STRUCTCOND_INITIAL_LR:-0.001}"
export NNUNET_STRUCTCOND_WEIGHT_DECAY="${NNUNET_STRUCTCOND_WEIGHT_DECAY:-0.00003}"
export NNUNET_STRUCTCOND_NUM_EPOCHS="${NNUNET_STRUCTCOND_NUM_EPOCHS:-3000}"
export NNUNET_STRUCTCOND_NUM_VAL_ITERS_PER_EPOCH="${NNUNET_STRUCTCOND_NUM_VAL_ITERS_PER_EPOCH:-50}"
export NNUNET_RAHPA_NUM_TRAIN_ITERS_PER_EPOCH="${NNUNET_RAHPA_NUM_TRAIN_ITERS_PER_EPOCH:-250}"
export NNUNET_STRUCTCOND_BATCH_SIZE="${NNUNET_STRUCTCOND_BATCH_SIZE:-1}"
export NNUNET_STRUCTCOND_COMPILE="${NNUNET_STRUCTCOND_COMPILE:-0}"
export NNUNET_USE_WANDB="${NNUNET_USE_WANDB:-0}"
